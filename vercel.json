{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "crons": [
    {
      "path": "/api/cron/push-inactive",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/cron/nudge",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/wa-reminders/evening",
      "schedule": "0 14-19 * * *"
    },
    {
      "path": "/api/cron/wa-reminders/night",
      "schedule": "55 19 * * *"
    },
    {
      "path": "/api/cron/wa-reminders/rebook",
      "schedule": "*/10 * * * *"
    }
  ]
}